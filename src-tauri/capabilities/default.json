{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://web.d3fau1t.net/api/**" }]
    }
  ]
}
